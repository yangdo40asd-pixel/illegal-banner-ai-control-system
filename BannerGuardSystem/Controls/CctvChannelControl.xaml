<UserControl x:Class="BannerGuardSystem.Controls.CctvChannelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:BannerGuardSystem.Models"
             xmlns:converters="clr-namespace:BannerGuardSystem.Converters"
             xmlns:controls="clr-namespace:BannerGuardSystem.Controls"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    
    <UserControl.Resources>
        <converters:ImageLoaderConverter x:Key="ImageLoaderConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#121212" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#26262B" Padding="8,4" CornerRadius="4,4,0,0" BorderBrush="#3F3F46" BorderThickness="1,1,1,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" Foreground="#F5F5F7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding ZoneLabel}" Foreground="#FF9F0A" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,4,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="0,0,4,4" Background="#000000" ClipToBounds="True">
            <Grid>
            <Grid x:Name="VideoContainerGrid" ClipToBounds="True" Background="#000000">
                <!-- VLC: HWND는 아래(0). 재생 실패 시 검은 화면이 포스터를 가리지 않도록 -->
                <vlc:VideoView x:Name="ChannelVideoView"
                               Background="Transparent"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Panel.ZIndex="0" />

                <!-- 포스터: 실제 프레임 확인 전까지 VideoView 위(1)에 유지 -->
                <Image x:Name="PlaceholderImage"
                       Source="{Binding DefaultImagePath, Converter={StaticResource ImageLoaderConverter}}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Panel.ZIndex="1"
                       Visibility="Visible"
                       IsHitTestVisible="False"/>

                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Padding="5,2" Background="#A0000000" CornerRadius="2" Panel.ZIndex="3" IsHitTestVisible="False">
                    <TextBlock Text="{Binding Name, StringFormat='인천광역시 {0}'}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                </Border>
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" Padding="5,2" Background="#A0000000" CornerRadius="2" Panel.ZIndex="3" IsHitTestVisible="False">
                    <TextBlock Text="LIVE" Foreground="#22C55E" FontSize="9" FontFamily="Consolas" FontWeight="Bold"/>
                </Border>

                <Canvas x:Name="RoiCanvas" Panel.ZIndex="4" Background="Transparent"
                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsRoiModeActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                        MouseDown="RoiCanvas_MouseDown" MouseMove="RoiCanvas_MouseMove" MouseUp="RoiCanvas_MouseUp">
                    <Border Canvas.Left="10" Canvas.Top="45" Background="#80000000" Padding="6" CornerRadius="4">
                        <TextBlock Text="[ROI 모드] 드래그하여 감시 제외 영역 지정" Foreground="White" FontSize="10"/>
                    </Border>
                    <Rectangle x:Name="TempRoiRect" Fill="#40FF4757" Stroke="#FF4757" StrokeThickness="1" Visibility="Collapsed"/>
                </Canvas>
            </Grid>

            <!-- VLC HWND 위에 WPF 박스를 올리기 위한 Popup (HwndHost airspace 우회) -->
            <Popup x:Name="YoloPopup"
                   PlacementTarget="{Binding ElementName=VideoContainerGrid}"
                   Placement="Relative"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   IsHitTestVisible="False">
                <controls:YoloBBoxOverlay x:Name="YoloOverlay"
                                        DataContext="{Binding DataContext, ElementName=VideoContainerGrid}"
                                        Background="Transparent"
                                        Alerts="{Binding CurrentAlerts}"
                                        NativeFrameWidth="{Binding OverlayFrameWidth}"
                                        NativeFrameHeight="{Binding OverlayFrameHeight}"
                                        IsActive="{Binding HasDetections}"
                                        OverlayOnly="True"/>
            </Popup>
            </Grid>
        </Border>
    </Grid>
</UserControl>