<Window x:Class="BannerGuardSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BannerGuardSystem.Controls"
        xmlns:viewmodels="clr-namespace:BannerGuardSystem.ViewModels"
        xmlns:models="clr-namespace:BannerGuardSystem.Models"
        mc:Ignorable="d"
        Title="BannerGuardSystem - 지능형 불법 현수막 통합 관제 시스템" 
        Height="900" Width="1600"
        Background="#141416"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Style for Channel Selector RadioButtons -->
        <Style x:Key="ChannelTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" 
                                Background="#1C1C1E" 
                                BorderBrush="#2C2C2E" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="16,8" 
                                Margin="0,0,8,0"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse x:Name="Indicator" Width="8" Height="8" Fill="#8E8E93" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252529"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#34C759"/>
                                <Setter TargetName="Indicator" Property="Fill" Value="#34C759"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#8E8E93"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#AEAEB2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- [구역 D] 상단 상태 표시줄 (Top Status Bar) -->
        <Border Grid.Row="0" Background="#16161A" BorderBrush="#2C2C2E" BorderThickness="0,0,0,1" Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Title & Menu Icon -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="☰" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="지능형 불법 현수막 통합 관제 시스템" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Border CornerRadius="4" Background="#FF9500" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SystemModeText}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Center Telemetry Indicators -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CPU Usage: " Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CpuUsageText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text=" | RAM Usage: " Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RamUsageText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text=" | GPU Usage: " Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GpuUsageText}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock Text=" | LibVLC DXVA2 가속 활성화" Foreground="#34C759" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | AI 상태: " Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AiStatusText}" Foreground="#FFCC00" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IsImageCropEnabledText}" Foreground="#34C759" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Connection LED Status & Hotkey Helper -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="AI server: " Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                        <Ellipse Width="6" Height="6" Fill="#34C759" Margin="4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#34C759" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="| ws://localhost:8000" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="[Space] 단속 확정 | [Esc] 기각 (PDF 생성 대기 중)" Foreground="#FFCC00" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- [구역 A] CCTV 단일 뷰어 Grid (Left Panel) -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRoiMaskMode}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="2"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Channel Switch Tabs -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Channels}" Margin="4,0,4,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Name}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         GroupName="ChannelGroup"
                                         Style="{StaticResource ChannelTabButtonStyle}"
                                         Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Single Channel CCTV View -->
                <controls:CctvChannelControl Grid.Row="1"
                                             DataContext="{Binding SelectedChannel}"
                                             IsRoiModeActive="{Binding DataContext.IsRoiMaskMode, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>

            <!-- Right Controls Panel -->
            <Grid Grid.Column="1" Margin="0,10,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="320"/> <!-- [구역 B] 실시간 현수막 크롭(확대) 영역 -->
                    <RowDefinition Height="*"/>   <!-- 3-Tier Diagnostics Panel -->
                    <RowDefinition Height="230"/> <!-- [구역 C] 실시간 피드 / 상습 위반 이력 통합 탭 -->
                </Grid.RowDefinitions>

                <!-- [구역 B] 실시간 현수막 크롭(확대) 영역 -->
                <Border Grid.Row="0" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="실시간 현수막 크롭 이미지" Foreground="#F5F5F7" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <Border Margin="10,0,0,0" Background="{Binding ActiveAlert.VerdictColor}" Padding="8,3" CornerRadius="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveAlert.VerdictIcon, FallbackValue='검출 없음'}" Foreground="Black" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="B" Foreground="#FF9F0A" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Crop Image Snapshot -->
                        <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="Black" BorderBrush="#2C2C2E" BorderThickness="1">
                            <Grid>
                                <Image Source="{Binding ActiveAlert.CroppedImageBase64, Converter={StaticResource ImageLoaderConverter}}" 
                                       Stretch="Uniform" 
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                
                                <Border Visibility="{Binding HasNoActiveAlert, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Background="#CC121214">
                                    <TextBlock Text="수신된 현수막 탐지 이벤트가 없습니다." Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3-Tier Diagnostics Panel -->
                <Border Grid.Row="1" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="단속 검증 상세 데이터 (3-Tier)" Foreground="#F5F5F7" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="✦" Foreground="#FF9F0A" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveAlert}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel>
                                    <!-- Tier 1 Section -->
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Tier 1: YOLOv26s 탐지 정보" Foreground="#FF9F0A" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Border BorderBrush="#2C2C2E" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="객체 ID" Foreground="#8E8E93" FontSize="10" Margin="0,2"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveAlert.ObjectIdText, FallbackValue='B_123'}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" Margin="0,2"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="탐지 시간" Foreground="#8E8E93" FontSize="10" Margin="0,2"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveAlert.DetectedAtText, FallbackValue='14:10:57'}" Foreground="#FFFFFF" FontSize="10" Margin="0,2" FontFamily="Consolas"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="검출 영역 (BBox)" Foreground="#8E8E93" FontSize="10" Margin="0,2"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActiveAlert.YoloCoordsText, FallbackValue='[102, 50, 410, 201]'}" Foreground="#FFFFFF" FontSize="10" Margin="0,2" FontFamily="Consolas"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Tier 2 Section -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Tier 2: EasyOCR 문자 판독" Foreground="#FF9F0A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" Background="#FFCC00" Padding="4,1" CornerRadius="3">
                                                <TextBlock Text="{Binding ActiveAlert.Tier2StatusText, FallbackValue='수행 전'}" Foreground="Black" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <Border BorderBrush="#2C2C2E" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="판독 문구" Foreground="#8E8E93" FontSize="10" Margin="0,2"/>
                                                <Border Grid.Row="0" Grid.Column="1" Background="#121214" CornerRadius="4" Padding="6,4" Margin="0,2">
                                                    <TextBlock Text="{Binding ActiveAlert.OcrText, TargetNullValue='[문자 없음]', FallbackValue='[수행 전]'}" Foreground="#FFFFFF" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                </Border>

                                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="신뢰도 (Confidence)" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Background="#121214" CornerRadius="4" Padding="4,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding ActiveAlert.OcrConfidenceText, FallbackValue='N/A'}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                    
                                                    <TextBlock Grid.Column="2" Text="누적 유지 시간" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3" Background="#121214" CornerRadius="4" Padding="4,2">
                                                        <TextBlock Text="{Binding ActiveAlert.StayDurationText, FallbackValue='0s'}" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Tier 3 Section -->
                                    <StackPanel Margin="0,0,0,4">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Tier 3: Qwen2.5-VL 맥락 분석" Foreground="#FF9F0A" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" Background="#FFCC00" Padding="4,1" CornerRadius="3">
                                                <TextBlock Text="{Binding ActiveAlert.Tier3StatusText, FallbackValue='수행 전'}" Foreground="Black" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="VLM 상세 판정" Foreground="#8E8E93" FontSize="10" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveAlert.VlmAnalysis, TargetNullValue='대기 중', FallbackValue='대기 중'}" Foreground="#FFFFFF" FontSize="10" Margin="0,2" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="상습 위반 의심" Foreground="#8E8E93" FontSize="10" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="아님" Foreground="#8E8E93" FontSize="10" Margin="0,2">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveAlert.IsRepeatOffender}" Value="True">
                                                                <Setter Property="Text" Value="상습 위반 탐지!"/>
                                                                <Setter Property="Foreground" Value="#FFCC00"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!-- Placeholder when no alert -->
                        <Border Grid.Row="1" Background="#121214" CornerRadius="4" Visibility="{Binding HasNoActiveAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="현재 선택된 검증 데이터 상세가 없습니다." Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- [구역 C] 실시간 피드 / 상습 위반 이력 통합 탭 -->
                <Border Grid.Row="2" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="6" Padding="10">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <TabControl.Resources>
                            <!-- Clean Dark TabStyle -->
                            <Style TargetType="TabItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#AEAEB2"/>
                                <Setter Property="Padding" Value="14,4"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,8,0" Cursor="Hand">
                                                <ContentPresenter x:Name="ContentSite" ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FF9F0A"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>
                        
                        <TabItem Header="실시간 피드">
                            <ListBox ItemsSource="{Binding AlertFeed}" 
                                     SelectedItem="{Binding ActiveAlert, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Margin="0,6,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#121214" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CctvName}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding LocationAddress}" Foreground="#AEAEB2" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding OcrPreviewText}" Foreground="#FFCC00" FontSize="9" FontWeight="SemiBold" Visibility="{Binding HasOcrPreview, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DetectedAtText}" Foreground="#8E8E93" FontSize="9" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding ConfidenceText}" Foreground="#34C759" FontSize="9" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        
                        <TabItem Header="상습 위반 이력">
                            <DataGrid ItemsSource="{Binding HistoryLog}"
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      IsReadOnly="True"
                                      Background="#121214" 
                                      BorderBrush="#2C2C2E"
                                      HeadersVisibility="Column" 
                                      GridLinesVisibility="None"
                                      RowHeaderWidth="0"
                                      Margin="0,6,0,0">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#262629"/>
                                        <Setter Property="Foreground" Value="#AEAEB2"/>
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="9"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="#121214"/>
                                        <Setter Property="Foreground" Value="#D1D1D6"/>
                                        <Setter Property="FontSize" Value="9"/>
                                        <Setter Property="Padding" Value="2"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="날짜" Binding="{Binding DetectedDateText}" Width="1*"/>
                                    <DataGridTextColumn Header="위치" Binding="{Binding LocationAddress}" Width="1.2*"/>
                                    <DataGridTextColumn Header="적발 문구" Binding="{Binding MatchedText}" Width="1.5*"/>
                                    <DataGridTextColumn Header="유사도" Binding="{Binding SimilarityText}" Width="0.6*"/>
                                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="0.8*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
