<UserControl x:Class="BannerGuardSystem.Views.EnforcementStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:converters="clr-namespace:BannerGuardSystem.Converters"
             xmlns:models="clr-namespace:BannerGuardSystem.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#F0F2F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <converters:EnforcementStatusToBackgroundConverter x:Key="StatusBgConverter"/>
        <converters:EnforcementStatusToForegroundConverter x:Key="StatusFgConverter"/>
        <converters:EnforcementStatusToRowBackgroundConverter x:Key="RowBgConverter"/>
        <converters:EnforcementViolationTypeToBackgroundConverter x:Key="TypeBgConverter"/>
        <converters:EnforcementViolationTypeToForegroundConverter x:Key="TypeFgConverter"/>

        <Style x:Key="PillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BlueActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeActionButton" TargetType="Button" BasedOn="{StaticResource BlueActionButton}">
            <Setter Property="Background" Value="#F97316"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- KPI Cards -->
            <UniformGrid Grid.Row="0" Columns="2">
                <Border Background="White" CornerRadius="8" Margin="0,0,6,0" Padding="18,14">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#C0C0C0" Opacity="0.25"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="금일 단속" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding TodayCount}" FontSize="28" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Text="{Binding TodayDeltaText}" FontSize="11" Foreground="#16A34A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Margin="6,0,0,0" Padding="18,14">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#C0C0C0" Opacity="0.25"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="금주 단속" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding WeekCount}" FontSize="28" FontWeight="Bold" Foreground="#1E40AF"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Search + Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Height="40" Padding="12,0">
                    <Grid>
                        <md:PackIcon Kind="Magnify" Foreground="#9CA3AF" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Margin="28,0,0,0"
                                 VerticalAlignment="Center" FontSize="13"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="엑셀 다운로드" Command="{Binding ExportExcelCommand}"
                            Background="#00A896" Foreground="White" BorderThickness="0"
                            Padding="14,8" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                    <Button Content="인쇄" Command="{Binding PrintCommand}"
                            Background="White" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1"
                            Padding="14,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Step 4: Main Table -->
            <Border Grid.Row="4" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1">
                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#C0C0C0" Opacity="0.2"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="단속번호" FontWeight="SemiBold" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="적발일시" FontWeight="SemiBold" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="2" Text="단속위치" FontWeight="SemiBold" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="3" Text="현수막 내용 (한줄)" FontWeight="SemiBold" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="4" Text="위반유형" FontWeight="SemiBold" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="처리상태" FontWeight="SemiBold" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="액션" FontWeight="SemiBold" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding Records}"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:EnforcementRecord}">
                                <Border x:Name="RowBorder" Padding="14,12" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                                        Background="{Binding Status, Converter={StaticResource RowBgConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding EnforcementNoDisplay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DetectedAtText}" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Location}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding BannerSummaryOneLine}" FontSize="11" Foreground="#334155"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding OcrText}"/>
                                        <Border Grid.Column="4" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding ViolationType, Converter={StaticResource TypeBgConverter}}">
                                            <TextBlock Text="{Binding ViolationTypeDisplay}" Style="{StaticResource PillTextStyle}"
                                                       Foreground="{Binding ViolationType, Converter={StaticResource TypeFgConverter}}"/>
                                        </Border>
                                        <Border Grid.Column="5" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding Status, Converter={StaticResource StatusBgConverter}}">
                                            <TextBlock Text="{Binding StatusDisplay}" Style="{StaticResource PillTextStyle}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusFgConverter}}"/>
                                        </Border>
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="{Binding PrimaryAction}" Style="{StaticResource BlueActionButton}" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.DetailCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="{Binding SecondaryAction}" Style="{StaticResource OrangeActionButton}"
                                                    Command="{Binding DataContext.SecondaryActionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Step 5 + 6: Bottom panels -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Similarity review -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="TextSearch" Foreground="#2563EB" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="유사 현수막 검토" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Margin="0,10,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                CornerRadius="6" Padding="12,8"
                                Visibility="{Binding HasSimilarRecords, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Compare" Foreground="#2563EB" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SimilaritySummary}" FontSize="12" Foreground="#1E40AF"
                                           FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Row="1" Margin="0,10,0,0" Text="{Binding SimilaritySummary}" FontSize="12" Foreground="#64748B"
                                   Visibility="{Binding HasSimilarRecords, Converter={StaticResource InvBoolVis}}"/>
                        <ListView Grid.Row="3" ItemsSource="{Binding SimilarityRecords}" BorderThickness="0" Background="Transparent">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="일자" DisplayMemberBinding="{Binding DetectedDateText}" Width="90"/>
                                    <GridViewColumn Header="단속위치" DisplayMemberBinding="{Binding Location}" Width="140"/>
                                    <GridViewColumn Header="현수막 한줄요약" DisplayMemberBinding="{Binding BannerSummary}" Width="220"/>
                                    <GridViewColumn Header="유사도" DisplayMemberBinding="{Binding SimilarityDisplay}" Width="60"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Map -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="단속 위치 지도" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <Border Grid.Row="1" Background="#E5E7EB" CornerRadius="6" ClipToBounds="True">
                            <wv2:WebView2 x:Name="MapWebView"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Step 7: Modal overlay -->
            <Grid Grid.RowSpan="7" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolVis}}" Panel.ZIndex="100">
                <Border Background="#99000000" MouseLeftButtonDown="Overlay_BackdropClick"/>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24">
                    <ContentControl Content="{Binding DialogRecord}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type models:EnforcementRecord}">
                                <Border Background="White" CornerRadius="8" Padding="24">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="16"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <StackPanel>
                                                <TextBlock Text="단속 상세" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                                                <TextBlock Text="{Binding EnforcementNoDisplay}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                                                <md:PackIcon Kind="Close" Width="20" Height="20" Foreground="#94A3B8"/>
                                            </Button>
                                        </Grid>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="{Binding Location, StringFormat=단속위치: {0}}" FontSize="14" Foreground="#334155" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding DetectedAtText, StringFormat=적발일시: {0}}" FontSize="12" Foreground="#64748B" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding BannerSummaryOneLine, StringFormat=현수막 요약: {0}}" FontSize="12" Foreground="#334155" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StatusDisplay, StringFormat=처리상태: {0}}" FontSize="12" Foreground="#2563EB" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Row="4" Background="#F1F5F9" CornerRadius="6" Padding="16">
                                            <TextBlock Text="AI 탐지 증거 이미지 및 행정 서류는 추후 VLM 검증 화면과 연동됩니다."
                                                       FontSize="12" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
            </Grid>
    </Grid>
</UserControl>