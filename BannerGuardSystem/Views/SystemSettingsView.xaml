<UserControl x:Class="BannerGuardSystem.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:converters="clr-namespace:BannerGuardSystem.Converters"
             xmlns:models="clr-namespace:BannerGuardSystem.Models"
             mc:Ignorable="d"
             Background="#F0F2F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:HexToBrushConverter x:Key="HexBrush"/>
        <converters:SettingsTabBackgroundConverter x:Key="TabBg"/>
        <converters:SettingsTabForegroundConverter x:Key="TabFg"/>

        <Style x:Key="SettingsTabBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FooterBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <md:PackIcon Kind="Cog" Width="22" Height="22" Foreground="#1E40AF" VerticalAlignment="Center"/>
            <TextBlock Text="시스템 설정" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 4 Tabs -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal">
                <Button Content="AI 탐지 설정" Style="{StaticResource SettingsTabBtn}" Command="{Binding SelectTabCommand}" CommandParameter="AiDetection"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBg}, ConverterParameter=AiDetection}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabFg}, ConverterParameter=AiDetection}"/>
                <Button Content="알림 설정" Style="{StaticResource SettingsTabBtn}" Command="{Binding SelectTabCommand}" CommandParameter="Notification"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBg}, ConverterParameter=Notification}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabFg}, ConverterParameter=Notification}"/>
                <Button Content="관할 구역" Style="{StaticResource SettingsTabBtn}" Command="{Binding SelectTabCommand}" CommandParameter="Jurisdiction"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBg}, ConverterParameter=Jurisdiction}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabFg}, ConverterParameter=Jurisdiction}"/>
                <Button Content="데이터 관리" Style="{StaticResource SettingsTabBtn}" Command="{Binding SelectTabCommand}" CommandParameter="Data"
                        Background="{Binding SelectedTab, Converter={StaticResource TabBg}, ConverterParameter=Data}"
                        Foreground="{Binding SelectedTab, Converter={StaticResource TabFg}, ConverterParameter=Data}"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Tab content -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- TAB1 AI -->
                    <StackPanel Visibility="{Binding IsAiTab, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="YOLO 탐지 임계값" FontWeight="Bold" FontSize="14"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding YoloThreshold, StringFormat={}{0:F0}%}" FontSize="32" FontWeight="Bold" Foreground="#1E40AF"/>
                                        <Border Background="#DCFCE7" CornerRadius="4" Padding="8,2" Margin="12,8,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="권장: 65~80%" FontSize="11" Foreground="#16A34A"/>
                                        </Border>
                                    </StackPanel>
                                    <Slider Minimum="50" Maximum="95" Value="{Binding YoloThreshold}" Margin="0,12,0,0" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding ExpectedDetectionsText}" FontSize="12" Foreground="#2563EB"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="시간 필터 / VLM" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="지속 탐지 기준" FontSize="11" Foreground="#6B7280" Margin="0,10,0,4"/>
                                    <ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding MinDurationFilter}"/>
                                    <TextBlock Text="긴급 분류 기준" FontSize="11" Foreground="#6B7280" Margin="0,10,0,4"/>
                                    <ComboBox ItemsSource="{Binding UrgentDurationOptions}" SelectedItem="{Binding UrgentDurationFilter}"/>
                                    <CheckBox Content="야간(22~06시) 기준 2배 적용" IsChecked="{Binding NightDoubleEnabled}" Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <TextBlock Text="VLM 분석" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <ToggleButton IsChecked="{Binding VlmEnabled}" Margin="12,0,0,0" Width="44"/>
                                    </StackPanel>
                                    <ComboBox ItemsSource="{Binding VlmModelOptions}" SelectedItem="{Binding VlmModel}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="내용분류 필터 (체크 시 탐지 제외)" FontWeight="Bold" FontSize="13"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <CheckBox Content="정치/선거" IsChecked="{Binding ExcludePolitics}" Margin="0,0,16,8"/>
                                    <CheckBox Content="상업/부동산" IsChecked="{Binding ExcludeCommercial}" Margin="0,0,16,8"/>
                                    <CheckBox Content="종교" IsChecked="{Binding ExcludeReligion}" Margin="0,0,16,8"/>
                                    <CheckBox Content="행사/모임" IsChecked="{Binding ExcludeEvent}" Margin="0,0,16,8"/>
                                    <CheckBox Content="개인/사업" IsChecked="{Binding ExcludePersonal}" Margin="0,0,16,8"/>
                                    <CheckBox Content="민원/항의" IsChecked="{Binding ExcludeCivil}" Margin="0,0,16,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB3 Notification -->
                    <StackPanel Visibility="{Binding IsNotificationTab, Converter={StaticResource BoolVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="긴급 알림 기준" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding UrgentConfidence, StringFormat={}{0:F0}%}" FontSize="32" FontWeight="Bold" Foreground="#DC2626" Margin="0,8,0,0"/>
                                    <Slider Minimum="50" Maximum="100" Value="{Binding UrgentConfidence}" Margin="0,8,0,0"/>
                                    <CheckBox Content="상업문구 포함 시 긴급" IsChecked="{Binding UrgentCommercial}" Margin="0,12,0,4"/>
                                    <CheckBox Content="스쿨존 위반 시 긴급" IsChecked="{Binding UrgentSchoolZone}" Margin="0,4,0,4"/>
                                    <CheckBox Content="지속 1시간 이상 시 긴급" IsChecked="{Binding UrgentDuration1h}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="알림 방식" FontWeight="Bold" FontSize="14"/>
                                    <CheckBox Content="화면 팝업 (필수)" IsChecked="True" IsEnabled="False" Margin="0,10,0,6"/>
                                    <CheckBox Content="사운드 알림" IsChecked="{Binding SoundEnabled}" Margin="0,4,0,6"/>
                                    <CheckBox Content="이메일 알림" IsChecked="{Binding EmailEnabled}" Margin="0,4,0,4"/>
                                    <TextBox Text="{Binding EmailAddress}" Margin="20,0,0,8" Height="28" FontSize="12"/>
                                    <CheckBox Content="SMS 알림" IsChecked="{Binding SmsEnabled}" Margin="0,4,0,4"/>
                                    <TextBox Text="{Binding SmsNumber}" Margin="20,0,0,0" Height="28" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="야간 설정 (22:00 ~ 06:00)" FontWeight="Bold" FontSize="14"/>
                                <ComboBox Margin="0,10,0,0" SelectedIndex="0" Width="160" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="화면만"/>
                                    <ComboBoxItem Content="진동만"/>
                                    <ComboBoxItem Content="전체 OFF"/>
                                </ComboBox>
                                <TextBlock Text="※ 야간 시간대 알림 방식을 선택합니다." FontSize="11" Foreground="#6B7280" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB4 Jurisdiction - simplified night mode without enum converter -->
                    <StackPanel Visibility="{Binding IsJurisdictionTab, Converter={StaticResource BoolVis}}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="시/도" FontSize="11" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding CityOptions}" SelectedItem="{Binding City}" Width="140" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="구/군" FontSize="11" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding DistrictOptions}" SelectedItem="{Binding District}" Width="140" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="160"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="관할 경계 미리보기" FontWeight="Bold" FontSize="13"/>
                                    <Border Grid.Row="1" Margin="0,8,0,0" CornerRadius="6" ClipToBounds="True" Background="#E5E7EB">
                                        <wv2:WebView2 x:Name="MapWebView"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="합법 게시대 DB" FontWeight="Bold" FontSize="13"/>
                                        <ListView ItemsSource="{Binding LegalBoards}" SelectedItem="{Binding SelectedBoard}" MaxHeight="120" BorderThickness="0" Margin="0,8,0,0">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="위치" Width="90" DisplayMemberBinding="{Binding Location}"/>
                                                    <GridViewColumn Header="규격" Width="60" DisplayMemberBinding="{Binding Spec}"/>
                                                    <GridViewColumn Header="관리번호" Width="90" DisplayMemberBinding="{Binding ManagementNo}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="추가" Command="{Binding AddBoardCommand}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="삭제" Command="{Binding DeleteBoardCommand}" Padding="10,4" FontSize="11" Margin="0,0,6,0"/>
                                            <Button Content="CSV 업로드" Command="{Binding ImportBoardCsvCommand}" Padding="10,4" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="스쿨존 설정" FontWeight="Bold" FontSize="13"/>
                                        <ListView ItemsSource="{Binding SchoolZones}" MaxHeight="100" BorderThickness="0" Margin="0,8,0,0">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="학교" Width="100" DisplayMemberBinding="{Binding SchoolName}"/>
                                                    <GridViewColumn Header="반경" Width="60" DisplayMemberBinding="{Binding RadiusMeters}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <Button Content="학교 추가" Command="{Binding AddSchoolCommand}" Padding="10,4" FontSize="11" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- TAB4 Data -->
                    <StackPanel Visibility="{Binding IsDataTab, Converter={StaticResource BoolVis}}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="자동 백업" FontWeight="Bold" FontSize="14"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="주기" FontSize="11" Foreground="#6B7280"/>
                                        <ComboBox SelectedIndex="0" Margin="0,4,8,0">
                                            <ComboBoxItem Content="매일"/>
                                            <ComboBoxItem Content="매주"/>
                                            <ComboBoxItem Content="매월"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="시간" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox Text="{Binding BackupTime}" Margin="0,4,8,0" Height="28"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="저장 경로" FontSize="11" Foreground="#6B7280"/>
                                        <TextBox Text="{Binding BackupPath}" Margin="0,4,0,0" Height="28"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="수동 백업 실행" Command="{Binding ManualBackupCommand}" Margin="0,12,0,0" Padding="12,6" HorizontalAlignment="Left" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="보관 기간" FontWeight="Bold" FontSize="14"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="탐지 로그" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding DetectionLogRetention}" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="신고 데이터" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding ReportRetention}" Margin="0,4,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CCTV 녹화" FontSize="11"/>
                                        <ComboBox ItemsSource="{Binding RecordingRetentionOptions}" SelectedItem="{Binding RecordingRetention}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="삭제 전보내기" IsChecked="{Binding ExportBeforeDelete}" Margin="0,12,0,0"/>
                                <Button Content="보관기간 경과 데이터 삭제" Command="{Binding PurgeDataCommand}" Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Left" Foreground="#DC2626" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="#FECACA">
                            <StackPanel>
                                <TextBlock Text="초기화 (주의)" FontWeight="Bold" FontSize="14" Foreground="#DC2626"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="전체 데이터 초기화" Command="{Binding ResetAllDataCommand}" Padding="12,6" Margin="0,0,8,0" Foreground="#DC2626" Cursor="Hand"/>
                                    <Button Content="설정만 초기화" Command="{Binding ResetSettingsOnlyCommand}" Padding="12,6" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- System info sidebar -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="시스템 정보" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                    <TextBlock FontSize="11" Foreground="#374151" Margin="0,0,0,6" Text="{Binding SystemYoloVersion, StringFormat=YOLO: {0}}"/>
                    <TextBlock FontSize="11" Foreground="#374151" Margin="0,0,0,6" Text="{Binding SystemVlmModel, StringFormat=VLM: {0}}"/>
                    <TextBlock FontSize="11" Foreground="#374151" Margin="0,0,0,6" Text="{Binding SystemDbVersion, StringFormat=DB: {0}}"/>
                    <TextBlock FontSize="11" Foreground="#16A34A" Margin="0,0,0,6" Text="{Binding ServerStatus, StringFormat=서버: {0}}"/>
                    <TextBlock FontSize="11" Foreground="#374151" Margin="0,0,0,6" Text="{Binding CpuText, StringFormat=CPU: {0}}"/>
                    <TextBlock FontSize="11" Foreground="#374151" Text="{Binding RamText, StringFormat=RAM: {0}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="초기화" Style="{StaticResource FooterBtn}" Command="{Binding ResetTabCommand}"
                        CommandParameter="{Binding SelectedTab}" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1"/>
                <Button Content="변경사항 취소" Style="{StaticResource FooterBtn}" Command="{Binding CancelCommand}" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1"/>
                <Button Content="저장" Style="{StaticResource FooterBtn}" Command="{Binding SaveCommand}" Background="#1E40AF" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Toast -->
        <Border Grid.Row="4" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#166534" CornerRadius="8" Padding="16,10" Margin="0,0,0,60"
                Visibility="{Binding ShowSaveToast, Converter={StaticResource BoolVis}}" Panel.ZIndex="50">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="CheckCircle" Foreground="White" Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock Text="설정이 저장되었습니다" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>