<UserControl x:Class="BannerGuardSystem.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:BannerGuardSystem.Converters"
             mc:Ignorable="d"
             Background="#F0F2F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:DataManagementTabBackgroundConverter x:Key="DmTabBg"/>
        <converters:DataManagementTabForegroundConverter x:Key="DmTabFg"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FooterBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DmTabButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <md:PackIcon Kind="Database" Width="22" Height="22" Foreground="#1E40AF" VerticalAlignment="Center"/>
            <TextBlock Text="데이터 관리" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="백업 · 보관" Style="{StaticResource DmTabButton}"
                    Command="{Binding SelectDataTabCommand}"
                    Background="{Binding SelectedPageTab, Converter={StaticResource DmTabBg}, ConverterParameter=Data}"
                    Foreground="{Binding SelectedPageTab, Converter={StaticResource DmTabFg}, ConverterParameter=Data}"/>
            <Button Content="모델 선택" Style="{StaticResource DmTabButton}"
                    Command="{Binding SelectModelTabCommand}"
                    Background="{Binding SelectedPageTab, Converter={StaticResource DmTabBg}, ConverterParameter=Model}"
                    Foreground="{Binding SelectedPageTab, Converter={StaticResource DmTabFg}, ConverterParameter=Model}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <!-- 탭: 백업 · 보관 -->
                <StackPanel Visibility="{Binding IsDataPageSelected, Converter={StaticResource BoolVis}}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="자동 백업" FontWeight="Bold" FontSize="14"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="주기" FontSize="11" Foreground="#6B7280"/>
                                    <ComboBox ItemsSource="{Binding BackupCycleOptions}"
                                              SelectedItem="{Binding AutoBackupCycle}"
                                              Margin="0,4,8,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="시간" FontSize="11" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding BackupTime}" Margin="0,4,8,0" Height="28"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="저장 경로" FontSize="11" Foreground="#6B7280"/>
                                    <TextBox Text="{Binding BackupPath}" Margin="0,4,0,0" Height="28"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="수동 백업 실행" Command="{Binding ManualBackupCommand}" Margin="0,12,0,0" Padding="12,6" HorizontalAlignment="Left" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="보관 기간" FontWeight="Bold" FontSize="14"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="탐지 로그" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding DetectionLogRetention}" Margin="0,4,8,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="신고 데이터" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding ReportRetention}" Margin="0,4,8,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CCTV 녹화" FontSize="11"/>
                                    <ComboBox ItemsSource="{Binding RecordingRetentionOptions}" SelectedItem="{Binding RecordingRetention}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="삭제 전보내기" IsChecked="{Binding ExportBeforeDelete}" Margin="0,12,0,0"/>
                            <Button Content="보관기간 경과 데이터 삭제" Command="{Binding PurgeDataCommand}" Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Left" Foreground="#DC2626" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="#FECACA">
                        <StackPanel>
                            <TextBlock Text="초기화 (주의)" FontWeight="Bold" FontSize="14" Foreground="#DC2626"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="전체 데이터 초기화" Command="{Binding ResetAllDataCommand}" Padding="12,6" Margin="0,0,8,0" Foreground="#DC2626" Cursor="Hand"/>
                                <Button Content="설정만 초기화" Command="{Binding ResetSettingsOnlyCommand}" Padding="12,6" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 탭: 모델 선택 -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding IsModelPageSelected, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <md:PackIcon Kind="Brain" Width="20" Height="20" Foreground="#1E40AF" VerticalAlignment="Center"/>
                            <TextBlock Text="VLM 모델 버전" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Vision-Language 모델을 선택합니다. VLM 검증·맥락 분석에 사용됩니다."
                                   FontSize="12" Foreground="#6B7280" Margin="0,4,0,16"/>

                        <TextBlock Text="모델 버전" FontSize="11" Foreground="#6B7280"/>
                        <ComboBox Margin="0,4,0,0" Height="32" MaxWidth="420" HorizontalAlignment="Left"
                                  ItemsSource="{Binding VlmModelOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="DisplayName"
                                  SelectedValue="{Binding SelectedVlmModelDisplayName}"/>

                        <TextBlock Text="{Binding SelectedVlmModelDescription}"
                                   FontSize="12" Foreground="#475569" Margin="0,12,0,0" TextWrapping="Wrap"/>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,16,0,0" MaxWidth="520" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="모델 ID" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SelectedVlmModelIdText}" FontSize="12" FontFamily="Consolas"
                                           Foreground="#334155" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="초기화" Style="{StaticResource FooterBtn}" Command="{Binding ResetDataCommand}" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1"/>
                <Button Content="변경사항 취소" Style="{StaticResource FooterBtn}" Command="{Binding CancelCommand}" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1"/>
                <Button Content="저장" Style="{StaticResource FooterBtn}" Command="{Binding SaveCommand}" Background="#1E40AF" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#166534" CornerRadius="8" Padding="16,10" Margin="0,0,0,20"
                Visibility="{Binding ShowSaveToast, Converter={StaticResource BoolVis}}" Panel.ZIndex="50">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="CheckCircle" Foreground="White" Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock Text="설정이 저장되었습니다" Foreground="White" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>