<UserControl x:Class="BannerGuardSystem.Views.RealTimeMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:BannerGuardSystem.Controls"
             xmlns:local="clr-namespace:BannerGuardSystem.Views"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1350"
             Background="#F5F7FA">

    <UserControl.Resources>
        <Style x:Key="FilterTabStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="15" Padding="15,6" Cursor="Hand">
                            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="#6B7280" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A237E"/>
                                <Setter TargetName="Text" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="260" />
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- [Step 1] Top KPI Cards (Row 0)                 -->
        <UniformGrid Grid.Row="0" Columns="3" Height="80" Rows="1">
            <!-- KPI 1: 오늘 탐지 건수 -->
            <Border Background="White" CornerRadius="8" Margin="0,0,10,0">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D0D0D0" Opacity="0.5"/></Border.Effect>
                <Grid Margin="20,10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="오늘 탐지 건수" FontSize="14" Foreground="#666666" Grid.Row="0"/>
                    <TextBlock Text="{Binding TodayDetectionCount}" FontSize="36" FontWeight="Bold" Foreground="#1E3A8A" Grid.Row="1" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- KPI 2: 처리 대기 -->
            <Border Background="White" CornerRadius="8" Margin="10,0,10,0">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D0D0D0" Opacity="0.5"/></Border.Effect>
                <Grid Margin="20,10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="처리 대기" FontSize="14" Foreground="#666666" Grid.Row="0"/>
                    <TextBlock Text="{Binding PendingCount}" FontSize="36" FontWeight="Bold" Foreground="#F97316" Grid.Row="1" VerticalAlignment="Bottom"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom">
                        <md:PackIcon Kind="AlertOutline" Foreground="#EF4444" VerticalAlignment="Center" Width="14" Height="14"/>
                        <TextBlock Text="{Binding EmergencyCount, StringFormat='긴급 {0}건'}" Foreground="#EF4444" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI 3: 처리 완료 -->
            <Border Background="White" CornerRadius="8" Margin="10,0,10,0">
                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D0D0D0" Opacity="0.5"/></Border.Effect>
                <Grid Margin="20,10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="처리 완료" FontSize="14" Foreground="#666666" Grid.Row="0"/>
                    <TextBlock Text="{Binding CompletedCount}" FontSize="36" FontWeight="Bold" Foreground="#22C55E" Grid.Row="1" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ============================================== -->
        <!-- Middle Content Area (Row 2)                    -->
        <!-- ============================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5.5*" /> <!-- 55% List -->
                <ColumnDefinition Width="20" /> <!-- Spacing -->
                <ColumnDefinition Width="4.5*" /> <!-- 45% Map -->
            </Grid.ColumnDefinitions>

            <!-- [Step 2] Left: 실시간 의심 현수막 목록 -->
            <Border Grid.Column="0" Background="White" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D0D0D0" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header & Filter -->
                    <Grid Grid.Row="0" Margin="15,15,15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <md:PackIcon Kind="AlertOutline" Foreground="#EF4444" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="실시간 의심 현수막 목록" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <RadioButton Content="전체" IsChecked="True" Style="{StaticResource FilterTabStyle}"/>
                            <RadioButton Content="긴급" Style="{StaticResource FilterTabStyle}" Margin="10,0"/>
                            <RadioButton Content="일반" Style="{StaticResource FilterTabStyle}"/>
                        </StackPanel>
                        
                        <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Magnify" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <TextBox Text="위치 검색..." Foreground="#9CA3AF" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" VerticalAlignment="Center" Width="100"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                    <!-- ListBox -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding AlertFeed}" IsSynchronizedWithCurrentItem="False"
                             BorderThickness="0" Background="Transparent" Margin="10,10,10,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder" Background="White" BorderBrush="#FBBF24" BorderThickness="4,0,0,0" CornerRadius="4" Height="90">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#E5E7EB" Opacity="0.5"/>
                                    </Border.Effect>
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Thumbnail -->
                                        <Border Grid.Column="0" Width="70" Height="70" Background="#F3F4F6" CornerRadius="4" BorderBrush="#E5E7EB" BorderThickness="1" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding CroppedImageBase64, Converter={StaticResource ImageLoaderConverter}}" Stretch="UniformToFill"/>
                                                <Border Background="#CC000000" VerticalAlignment="Bottom" HorizontalAlignment="Right" Padding="4,2" CornerRadius="2" Margin="2">
                                                    <TextBlock Text="CCTV" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        
                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <md:PackIcon Kind="MapMarker" Foreground="#9CA3AF" Width="14" Height="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding LocationAddress}" FontWeight="Bold" Foreground="#1F2937" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ObjectIdText}" Foreground="#6B7280" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding DetectedAtText}" Foreground="#6B7280" FontSize="12"/>
                                                <TextBlock Text=" | " Foreground="#D1D5DB" Margin="6,0"/>
                                                <TextBlock Text="{Binding StayDurationText, StringFormat='탐지 {0}째'}" Foreground="#6B7280" FontSize="12"/>
                                            </StackPanel>
                                            
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="ConfidenceText" Text="{Binding ConfidenceText, StringFormat='신뢰도 {0}'}" Foreground="#F59E0B" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text=" | " Foreground="#D1D5DB" Margin="6,0"/>
                                                <TextBlock Text="{Binding OcrPreviewText}" Foreground="#4B5563" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <!-- Review Button -->
                                        <Button Grid.Column="2" Content="검토" Background="#1A237E" Foreground="White" BorderThickness="0" 
                                                Padding="15,6" VerticalAlignment="Center" Command="{Binding DataContext.SelectAlertCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="16"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Use IsRepeatOffender as the 'High Risk / 긴급' trigger for now -->
                                    <DataTrigger Binding="{Binding IsRepeatOffender}" Value="True">
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#EF4444"/>
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#FEF2F2"/>
                                        <Setter TargetName="ConfidenceText" Property="Foreground" Value="#EF4444"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- [Step 4] Right: 탐지 위치 맵 및 CCTV 4분할 뼈대 -->
            <Border Grid.Column="2" Background="White" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D0D0D0" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="15,15,15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <md:PackIcon Kind="MapMarkerRadius" Foreground="#3B82F6" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="탐지 위치 맵" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="🔴 긴급" FontSize="11" Foreground="#6B7280" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🟢 처리중" FontSize="11" Foreground="#6B7280" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <!-- Map / CCTV Switch -->
                            <Border Background="#F3F4F6" CornerRadius="15" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="White" CornerRadius="13" Padding="12,4" Cursor="Hand">
                                        <TextBlock Text="🗺️ 지도" FontSize="11" FontWeight="Bold" Foreground="#1F2937"/>
                                    </Border>
                                    <Border Background="Transparent" CornerRadius="13" Padding="12,4" Cursor="Hand">
                                        <TextBlock Text="📺 CCTV" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                    <!-- WebView2 Map (Placeholder mapping) -->
                    <Grid Grid.Row="1" Margin="10">
                        <Border Background="#E5E7EB" CornerRadius="6" ClipToBounds="True">
                            <wv2:WebView2 x:Name="MapWebView" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================== -->
        <!-- [Step 3] Bottom: 상세 검증 패널 뼈대 (Row 4)    -->
        <!-- ============================================== -->
        <Border Grid.Row="4" Background="White" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#D0D0D0" Opacity="0.5"/>
            </Border.Effect>
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="MagnifyScan" Foreground="#1E3A8A" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="상세 검증" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="8,0,15,0" VerticalAlignment="Center"/>
                        <Border Background="#1A237E" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveAlert.ObjectIdText, StringFormat='의심 ID: #{0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#EF4444" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding ActiveAlert.IsRepeatOffender, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="긴급" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>

                <!-- Content Panels -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.5*"/> <!-- LIVE 영상 -->
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="4.5*"/> <!-- VLM 텍스트 -->
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="2*"/> <!-- Action Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- CCTV Snapshot -->
                    <Border Grid.Column="0" Background="Black" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <controls:YoloBBoxOverlay Alert="{Binding ActiveAlert}"
                                                      FrameSource="{Binding ActiveAlert.FullImageBase64}"
                                                      IsActive="{Binding HasActiveAlert}"
                                                      FrameOpacity="0.92"/>
                            <TextBlock Text="{Binding SelectedChannel.ChannelId, StringFormat='SNAPSHOT - {0}'}" Foreground="White" Background="#CC000000" Padding="6,2" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            
                            <!-- Placeholder Overlay for No Alert -->
                            <Border Background="#CC121214" Visibility="{Binding HasNoActiveAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="수신된 현수막 탐지 이벤트가 없습니다." Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Qwen Analysis Text -->
                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                                <Border Background="#E0F2FE" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="VLM" Foreground="#0284C7" FontSize="11" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="Qwen 분석 결과" Foreground="#1E293B" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                
                                <TextBlock Text="|" Foreground="#CBD5E1" Margin="10,0" VerticalAlignment="Center"/>
                                
                                <md:PackIcon Kind="Target" Foreground="#EF4444" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveAlert.YoloConfidenceText, StringFormat='객체 탐지율: {0}'}" Foreground="#EF4444" FontSize="12" FontWeight="Bold" Margin="4,0,10,0" VerticalAlignment="Center"/>
                                
                                <md:PackIcon Kind="TextRecognition" Foreground="#3B82F6" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ActiveAlert.OcrConfidenceText, StringFormat='문자 판독율: {0}'}" Foreground="#3B82F6" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="#E5E7EB" CornerRadius="4" Margin="0,0,0,10" HorizontalAlignment="Left" MaxHeight="160" ClipToBounds="True">
                                        <Image Source="{Binding ActiveAlert.CroppedImageBase64, Converter={StaticResource ImageLoaderConverter}}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding ActiveAlert.VlmAnalysis}" Foreground="#334155" FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
                                </StackPanel>
                            </ScrollViewer>
                            <!-- Placeholder Overlay for No Alert -->
                            <Border Grid.Row="1" Background="#F8FAFC" Visibility="{Binding HasNoActiveAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="AI 분석 결과가 없습니다." Foreground="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <Button Background="#22C55E" Foreground="White" BorderThickness="0" Padding="0,12" Margin="0,0,0,10" Command="{Binding ApproveCommand}" IsEnabled="{Binding HasActiveAlert}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="합법 확인" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Background="#EF4444" Foreground="White" BorderThickness="0" Padding="0,12" Margin="0,0,0,10" Command="{Binding ApproveCommand}" IsEnabled="{Binding HasActiveAlert}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="AlertOctagonOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="불법 확정" FontWeight="Bold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Background="#9CA3AF" Foreground="White" BorderThickness="0" Padding="0,10" Margin="0,0,0,15" Command="{Binding DismissCommand}" IsEnabled="{Binding HasActiveAlert}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ClockOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="재검토 요청" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
