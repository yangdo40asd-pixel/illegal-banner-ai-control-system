<UserControl x:Class="BannerGuardSystem.Views.StatisticsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:BannerGuardSystem.Converters"
             xmlns:models="clr-namespace:BannerGuardSystem.Models"
             mc:Ignorable="d"
             d:DesignHeight="1200" d:DesignWidth="1400"
             Background="#F0F2F5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <converters:PeriodTabBackgroundConverter x:Key="TabBg"/>
        <converters:PeriodTabForegroundConverter x:Key="TabFg"/>
        <converters:RankBarWidthConverter x:Key="BarWidth"/>
        <converters:HexToBrushConverter x:Key="HexBrush"/>

        <Style x:Key="PeriodTabButton" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#C0C0C0" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="280"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="260"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="320"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <md:PackIcon Kind="ChartBar" Width="22" Height="22" Foreground="#1E40AF" VerticalAlignment="Center"/>
                <TextBlock Text="통계 및 리포트" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PeriodHeaderText}" FontSize="13" Foreground="#64748B" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Period bar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="주간" Style="{StaticResource PeriodTabButton}"
                            Command="{Binding SelectPeriodCommand}" CommandParameter="Weekly"
                            Background="{Binding SelectedPeriod, Converter={StaticResource TabBg}, ConverterParameter=Weekly}"
                            Foreground="{Binding SelectedPeriod, Converter={StaticResource TabFg}, ConverterParameter=Weekly}"/>
                    <Button Content="월간" Style="{StaticResource PeriodTabButton}"
                            Command="{Binding SelectPeriodCommand}" CommandParameter="Monthly"
                            Background="{Binding SelectedPeriod, Converter={StaticResource TabBg}, ConverterParameter=Monthly}"
                            Foreground="{Binding SelectedPeriod, Converter={StaticResource TabFg}, ConverterParameter=Monthly}"/>
                    <Button Content="분기" Style="{StaticResource PeriodTabButton}"
                            Command="{Binding SelectPeriodCommand}" CommandParameter="Quarterly"
                            Background="{Binding SelectedPeriod, Converter={StaticResource TabBg}, ConverterParameter=Quarterly}"
                            Foreground="{Binding SelectedPeriod, Converter={StaticResource TabFg}, ConverterParameter=Quarterly}"/>
                    <Button Content="연간" Style="{StaticResource PeriodTabButton}"
                            Command="{Binding SelectPeriodCommand}" CommandParameter="Yearly"
                            Background="{Binding SelectedPeriod, Converter={StaticResource TabBg}, ConverterParameter=Yearly}"
                            Foreground="{Binding SelectedPeriod, Converter={StaticResource TabFg}, ConverterParameter=Yearly}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriodLabel}"
                              Width="160" Height="36" FontSize="13" VerticalContentAlignment="Center"/>
                    <CheckBox Content="전년도/전월과 비교" IsChecked="{Binding CompareWithPrevious}"
                              Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="리포트 다운로드" Command="{Binding DownloadReportCommand}"
                            Background="#00A896" Foreground="White" BorderThickness="0"
                            Padding="14,8" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                    <Button Content="인쇄" Command="{Binding PrintCommand}"
                            Background="White" Foreground="#374151" BorderBrush="#D1D5DB" BorderThickness="1"
                            Padding="14,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- KPI -->
            <UniformGrid Grid.Row="4" Columns="4">
                <Border Background="White" CornerRadius="8" Margin="0,0,6,0" Padding="16,12">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#C0C0C0" Opacity="0.25"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="총 적발 건수" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding TotalDetections, StringFormat={}{0}건}" FontSize="26" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Text="{Binding TotalDetectionsDeltaText}" FontSize="11" Foreground="#16A34A"
                                   Visibility="{Binding ShowComparison, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Margin="3,0" Padding="16,12">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#C0C0C0" Opacity="0.25"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="상습 위반 구역" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding RepeatViolationZoneCount, StringFormat={}{0}곳}" FontSize="26" FontWeight="Bold" Foreground="#EA580C"/>
                        <TextBlock Text="{Binding RepeatViolationZoneSubText}" FontSize="11" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding RepeatViolationZoneDeltaText}" FontSize="11" Foreground="#16A34A" Margin="0,2,0,0"
                                   Visibility="{Binding ShowComparison, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Margin="3,0" Padding="16,12">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#C0C0C0" Opacity="0.25"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="처리율" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding ProcessingRateText}" FontSize="26" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Text="{Binding AvgProcessingDaysText}" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>
                <Border Background="White" CornerRadius="8" Margin="3,0,0,0" Padding="16,12">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#C0C0C0" Opacity="0.25"/></Border.Effect>
                    <StackPanel>
                        <TextBlock Text="오탐지율" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="{Binding FalsePositiveRateText}" FontSize="26" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Text="{Binding AiConfidenceText}" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Charts row 1 -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="지역별 위반 현황" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding DistrictSeries}"
                                            XAxes="{Binding DistrictXAxes}" YAxes="{Binding DistrictYAxes}"
                                            LegendPosition="Top" TooltipTextSize="12"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="내용분류별 비율" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1" Grid.Column="0">
                            <lvc:PieChart Series="{Binding CategorySeries}" LegendPosition="Hidden"/>
                            <TextBlock Text="{Binding DonutCenterText}" FontSize="14" FontWeight="Bold"
                                       Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:CategoryRatioItem}">
                                        <Button Background="Transparent" BorderThickness="0" Padding="0,4" Cursor="Hand"
                                                HorizontalContentAlignment="Left"
                                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Category}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{Binding ColorHex, Converter={StaticResource HexBrush}}"/>
                                                <TextBlock Text="{Binding LegendText}" FontSize="11" Foreground="#374151"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Charts row 2 -->
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="요일/시간대별 발생 패턴" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding HourlySeries}"
                                            XAxes="{Binding HourlyXAxes}" YAxes="{Binding HourlyYAxes}"
                                            LegendPosition="Bottom" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Text="{Binding PeakHourNote}" FontSize="10" Foreground="#EA580C" Margin="0,4,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="상습 위반 구역 Top 5" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                            <TextBlock Text="3회 이상 반복 적발 구역 기준" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopViolationZones}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:RepeatViolationZoneItem}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Grid Height="8" Margin="0,4,0,0">
                                                <Border Background="#F3F4F6" CornerRadius="4"/>
                                                <Border CornerRadius="4" HorizontalAlignment="Left"
                                                        Width="{Binding BarRatio, Converter={StaticResource BarWidth}}"
                                                        Background="{Binding BarColorHex, Converter={StaticResource HexBrush}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding StatsText}" FontSize="10" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Text="전체 구역 보기 &gt;" FontSize="11" Foreground="#2563EB" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom row -->
            <Grid Grid.Row="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="월별 단속 추이" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                        <lvc:CartesianChart Grid.Row="1" Series="{Binding MonthlySeries}"
                                            XAxes="{Binding MonthlyXAxes}"
                                            YAxes="{Binding MonthlyYAxes}"
                                            Margin="0,8,0,0" LegendPosition="Top"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ChartCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FlagVariant" Width="16" Height="16" Foreground="#DC2626" VerticalAlignment="Center"/>
                                <TextBlock Text="상습 적발 현수막" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="반복 게시 적발 · 집중관리 대상 현수막" FontSize="10" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding RepeatViolationBanners}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RepeatViolationBannerItem}">
                                        <StackPanel Margin="0,0,0,10">
                                            <Grid Height="34">
                                                <Border CornerRadius="2" BorderBrush="#374151" BorderThickness="1"
                                                        Background="{Binding BannerBgHex, Converter={StaticResource HexBrush}}"/>
                                                <Ellipse Width="5" Height="5" Fill="#4B5563" HorizontalAlignment="Left" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <Ellipse Width="5" Height="5" Fill="#4B5563" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding BannerText}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{Binding BannerTextColorHex, Converter={StaticResource HexBrush}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="16,0" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Grid Margin="2,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding MetaText}" FontSize="9" Foreground="#6B7280" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Border CornerRadius="2" Padding="4,1" Margin="0,0,4,0" Background="#FEE2E2">
                                                        <TextBlock Text="{Binding StatsText}" FontSize="8" FontWeight="Bold" Foreground="#DC2626"/>
                                                    </Border>
                                                    <Border CornerRadius="2" Padding="4,1" Background="#DBEAFE"
                                                            Visibility="{Binding IsNewThisMonth, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="신규" FontSize="8" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Drill-down panel -->
            <Border Grid.Row="12" Background="White" CornerRadius="8" BorderBrush="#BFDBFE" BorderThickness="1"
                    Padding="16" Margin="0,4,0,0"
                    Visibility="{Binding HasDrillDown, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DrillDownTitle}" FontSize="14" FontWeight="Bold" Foreground="#1E40AF"/>
                        <ItemsControl ItemsSource="{Binding DrillDownItems}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DrillDownItem}">
                                    <Border Background="#F1F5F9" CornerRadius="6" Padding="12,6" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding DisplayText}" FontSize="12" Foreground="#334155"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="1" Content="닫기" Command="{Binding ClearDrillDownCommand}"
                            VerticalAlignment="Top" Padding="12,6" FontSize="12" Cursor="Hand"
                            Background="#E5E7EB" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>