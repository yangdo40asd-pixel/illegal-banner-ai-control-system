<UserControl x:Class="BannerGuardSystem.Views.CctvMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:BannerGuardSystem.Controls"
             xmlns:models="clr-namespace:BannerGuardSystem.Models"
             xmlns:converters="clr-namespace:BannerGuardSystem.Converters"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1400" Background="#E5E7EB">

    <UserControl.Resources>
        <DataTemplate x:Key="LogItemTemplate">
            <Border Background="White" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="15,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontSize="12" Foreground="#9CA3AF"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="현수막 의심" FontSize="12" FontWeight="Bold" Foreground="#EF4444"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CctvId}" FontSize="13" FontWeight="SemiBold" Foreground="#374151" Margin="0,4,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfidenceScore, StringFormat={}{0:P0}}" FontSize="13" FontWeight="Bold" Foreground="#EF4444" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
        
        <converters:ImageLoaderConverter x:Key="ImageLoaderConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- LEFT AREA -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="250" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,0,1,1" Padding="20,0">
                <Grid>
                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="VideoOutline" Foreground="#1E3A8A" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="실시간 CCTV 모니터링" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- 2x2 Grid: 제출용 고정 4채널 (Channels[0..3]) -->
            <Border Grid.Row="1" Background="#263238" BorderBrush="#374151" BorderThickness="0,0,1,0">
                <UniformGrid Rows="2" Columns="2" Margin="15">
                    <controls:CctvChannelControl DataContext="{Binding Channels[0]}" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <controls:CctvChannelControl DataContext="{Binding Channels[1]}" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <controls:CctvChannelControl DataContext="{Binding Channels[2]}" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <controls:CctvChannelControl DataContext="{Binding Channels[3]}" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </UniformGrid>
            </Border>

            <!-- Bottom Panel -->
            <Border Grid.Row="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="0,1,1,0" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Selected Video Thumbnail & Channel Tabs -->
                    <StackPanel Grid.Column="0">
                        <Border Background="#111827" Height="150" CornerRadius="4" BorderBrush="#374151" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <controls:YoloBBoxOverlay Alerts="{Binding SelectedChannel.CurrentAlerts}"
                                                          Alert="{Binding SelectedChannel.CurrentAlert}"
                                                          FrameSource="{Binding SelectedChannel.DetectionFrameSource}"
                                                          NativeFrameWidth="{Binding SelectedChannel.OverlayFrameWidth}"
                                                          NativeFrameHeight="{Binding SelectedChannel.OverlayFrameHeight}"
                                                          IsActive="{Binding SelectedChannel.IsAlerting}"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10">
                                    <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedChannel.ChannelId, StringFormat='LIVE · {0}'}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sub Channels (Dynamic Buttons) -->
                        <ItemsControl ItemsSource="{Binding Channels}" Margin="0,15,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            Height="40" Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#1F2937"/>
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#374151"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding ChannelId}" FontSize="11" FontWeight="SemiBold"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Center: Details -->
                    <StackPanel Grid.Column="1" Margin="30,0,0,0">
                        <TextBlock Text="{Binding SelectedChannel.Name}" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,20"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="최종 탐지 시간" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedChannel.CurrentAlert.Timestamp, StringFormat={}{0:HH:mm:ss}, TargetNullValue='-'}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>
                                
                                <TextBlock Text="신뢰도" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedChannel.CurrentAlert.Confidence, StringFormat={}{0:P0}, TargetNullValue='-'}" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="지속 시간" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedChannel.CurrentAlert.StayDurationText, TargetNullValue='-'}" FontSize="16" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20"/>
                                
                                <TextBlock Text="상태" FontSize="12" Foreground="#6B7280" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedChannel.StatusText, TargetNullValue='-'}" FontSize="16" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- RIGHT AREA: Log List -->
        <Border Grid.Column="1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <md:PackIcon Kind="AlarmLight" Foreground="#EF4444" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="실시간 탐지 로그" FontSize="15" FontWeight="Bold" Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <TextBlock Grid.Row="0" Text="클릭 시 해당 CCTV 강조" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,8"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding CctvDetectionLog}" ItemTemplate="{StaticResource LogItemTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
